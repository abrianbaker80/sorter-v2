+    assert ctx.sending.step() is DistributionState.IDLE
+    assert calls[0] == calls[1]
+    assert ctx.events.qsize() == 1
+    assert ctx.gc.set_progress_tracker.calls == 1
+    assert followup(ctx)["state"] == "CLOSED"
