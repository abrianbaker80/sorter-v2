+    assert calls[0][0] == calls[1][0] and calls[0][1] is calls[1][1]
+    assert followup(ctx)["state"] == "CLOSED"
+    assert ctx.counts() == (1, 1, 0)
+    assert ctx.events.qsize() == 1
