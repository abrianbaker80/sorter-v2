+
+    with pytest.raises(MCUBusError, match="max frame size"):
+        bus.send_command(0, GET_STALL_STATUS, 0, b"", retries=99)
+
+    assert len(port.writes) == 1
+    assert bus._unresolved_addresses == {0}
