+    adapter = getattr(gc, "smart_bins_native_adapter", None)
+    if adapter is None:
+        adapter = NativeCustodyAdapter(gc.machine_id)
+        gc.smart_bins_native_adapter = adapter
+    custody.install(adapter if adapter.active or adapter.blocked else None)
+    return adapter
