+        if self.active:
+            custody.machine_observation(
+                self.machine_id,
+                self.incarnation,
+                "CHANNEL_CLEAR_OBSERVED",
+                {
+                    "exact_piece_identity": None,
+                    "quantity": None,
+                    "actual_destination": None,
+                    "receiving_evidence": False,
+                },
+            )
