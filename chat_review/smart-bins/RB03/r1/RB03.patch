+            conn.execute("UPDATE smart_bin_native_evidence SET kind='INFERRED_EXIT'")
+        with pytest.raises(sqlite3.IntegrityError):
+            conn.execute("UPDATE smart_bin_native_claims SET status='RELEASE_INTENT'")
