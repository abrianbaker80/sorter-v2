+@pytest.fixture
+def context(prepared, monkeypatch):
+    ctx = _Context(prepared)
+    import subsystems.distribution.sending as sending_module
+
+    monkeypatch.setattr(sending_module, "time", SimpleNamespace(time=lambda: ctx.clock[0]))
+    return ctx
+
