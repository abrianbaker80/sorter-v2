+@pytest.mark.parametrize("fail", [False, True])
+def test_supplied_connection_restores_disabled_fk_and_retains_ownership(prepared, fail):
+    conn = sqlite3.connect(prepared)
+    conn.execute("PRAGMA synchronous=NORMAL")
+    assert conn.execute("PRAGMA foreign_keys").fetchone()[0] == 0
+    trace = []
+    conn.set_trace_callback(trace.append)
+    try:
+        try:
+            with storage.critical_transaction(conn) as tx:
+                assert tx is conn and tx.in_transaction
+                assert tx.execute("PRAGMA foreign_keys").fetchone()[0] == 1
+                assert tx.execute("PRAGMA synchronous").fetchone()[0] == 2
+                tx.execute("INSERT INTO smart_bin_machines(machine_id) VALUES('owned')")
+                if fail:
+                    raise OSError("injected")
+                tx.commit()
+        except OSError:
+            assert fail
+        assert "BEGIN IMMEDIATE" in trace
+        assert conn.execute("PRAGMA synchronous").fetchone()[0] == 1
+        assert conn.execute("PRAGMA foreign_keys").fetchone()[0] == 0
+        assert conn.execute("SELECT count(*) FROM smart_bin_machines").fetchone()[0] == int(not fail)
+        conn.execute("BEGIN")
+        conn.execute("INSERT INTO smart_bin_machines(machine_id) VALUES('outer')")
+        with pytest.raises(RuntimeError, match="nested"):
+            with storage.critical_transaction(conn):
+                pass
+        assert conn.in_transaction
+        conn.rollback()
+    finally:
+        conn.close()
